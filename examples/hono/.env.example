# Apple Wallet — see examples/README.md for how to obtain these
APPLE_PASS_TYPE_IDENTIFIER="pass.com.yourcompany.rewards"
APPLE_TEAM_ID="ABCD1234EF"
# PEM contents, not file paths. Multi-line values must be quoted.
APPLE_SIGNER_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
APPLE_SIGNER_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_WWDR="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Google Wallet — from the Pay & Wallet Console + service-account JSON key
GOOGLE_ISSUER_ID="3388000000000000000"
GOOGLE_CLIENT_EMAIL="passes@your-project.iam.gserviceaccount.com"
# Keep the literal \n escapes; the app restores real newlines at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Google accepts hosted image URLs only.
GOOGLE_LOGO_URL="https://cdn.example.com/logo.png"

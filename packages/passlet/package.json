{
  "name": "passlet",
  "version": "2.0.1",
  "type": "module",
  "description": "Generate Apple Wallet and Google Wallet passes from a single API",
  "keywords": [
    "apple-wallet",
    "google-wallet",
    "passkit",
    "pkpass",
    "wallet",
    "pass"
  ],
  "homepage": "https://passlet.oscartrev.io",
  "bugs": "https://github.com/oscartrevio/passlet/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oscartrevio/passlet"
  },
  "engines": {
    "node": ">=20.15"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit --project integration",
    "prepack": "cp ../../README.md README.md"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@passlet/config": "workspace:*",
    "@types/node-forge": "^1.3.14",
    "jose": "^5.10.0",
    "jszip": "^3.10.1",
    "node-forge": "^1.4.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}

{
  "name": "passlet",
  "version": "3.2.0",
  "type": "module",
  "description": "Generate Apple Wallet and Google Wallet passes from a single API",
  "keywords": [
    "apple-wallet",
    "google-wallet",
    "passkit",
    "pkpass",
    "wallet",
    "pass"
  ],
  "homepage": "https://passlet.oscartrev.io",
  "bugs": "https://github.com/oscartrevio/passlet/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscartrevio/passlet.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit --project integration",
    "bench": "vitest bench --run --project bench",
    "check-size": "node scripts/check-size.mjs",
    "update-google-schema": "node scripts/update-google-schema.ts && biome format --write test/support/google-discovery.json",
    "prepack": "cp ../../README.md ../../LICENSE ."
  },
  "devDependencies": {
    "@passlet/config": "workspace:*",
    "jszip": "^3.10.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}
